{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Swift: Build",
      "type": "shell",
      "command": "swift build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$swiftc"
    },
    {
      "label": "Swift: Test",
      "type": "shell",
      "command": "swift test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": "$swiftc"
    },
    {
      "label": "Swift: Validate Sterling",
      "type": "shell",
      "command": "swift run TamaChecks",
      "problemMatcher": "$swiftc"
    },
    {
      "label": "Swift: Build Release",
      "type": "shell",
      "command": "swift build -c release --product Tama -debug-info-format none",
      "group": "build",
      "problemMatcher": "$swiftc"
    },
    {
      "label": "Swift: Run Tama",
      "type": "shell",
      "command": "swift run Tama",
      "problemMatcher": "$swiftc"
    }
  ]
}
